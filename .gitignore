# Python
__pycache__/
*.py[cod]
.venv*/
.pytest_cache/
.ruff_cache/

# Jupyter
.ipynb_checkpoints/
# notebooks/*.py (jupytext) is the source of truth and IS committed.
# colab/*.ipynb is generated and IS committed (students launch from it).

# Lab artifacts — regenerated by the notebooks, never committed
# adapters/correct/ config files committed; large binaries excluded (>100MB GitHub limit)
!adapters/correct/
# Exclude large binary files that exceed GitHub 100MB limit
*.safetensors
adapters/correct/tokenizer.json
data/split/
data/CUSTOM_DATASET.md
# results/ files are committed — grader needs them
!results/.gitkeep
gguf/
*.gguf
runs/
wandb/

# Model / HF cache
.cache/
hf_cache/

